* text=auto eol=lf

# Preserve the imported snapshot byte-for-byte, including CRLF and BOM data.
sources/windows-seh-tests/** -text

*.exe binary
*.dll binary
*.lib binary
*.obj binary
*.so binary
*.dylib binary

# Linux and macOS executables have no extension, so the generated Rust
# artifacts are marked binary by the layout the manifest schema enforces:
# corpus/rust-eh/<target>/<panic>/<optimization>/<crate type>/<file>. Matching
# the artifact directories rather than the whole tree leaves the notice at the
# root of it an ordinary, diffable text file.
corpus/rust-eh/*/*/*/bin/** binary
corpus/rust-eh/*/*/*/cdylib/** binary

# The same holds for Go, whose `exe` and `pie` artifacts carry no extension off
# Windows.  The layout the manifest schema enforces is
# corpus/go-eh/<release>/<os>-<arch>/<mode>/<cgo>/<symbols>/<optimization>/<file>,
# so matching at that depth leaves the tree's own notice a diffable text file.
corpus/go-eh/*/*/*/*/*/*/** binary

# And for the C++ Itanium line, whose ELF and Mach-O executables have no
# extension either.  Its schema enforces
# corpus/cxx-itanium-eh/<toolchain>/<target>/<optimization>/<symbols>/<kind>/<file>,
# and `<kind>` is the last directory, so the two artifact kinds are matched by
# name and the notice at the root of the tree stays diffable text.
corpus/cxx-itanium-eh/*/*/*/*/exe/** binary
corpus/cxx-itanium-eh/*/*/*/*/shared/** binary

# Objective-C artifacts are extensionless Mach-O executables. The schema
# enforces corpus/objc-eh/<runtime>/<target>/<optimization>/<symbols>/<file>,
# so this depth excludes the generated-tree notice at the product-line root.
corpus/objc-eh/*/*/*/*/** binary

# Ada/D ELF executables have no extension. The schema enforces
# corpus/ada-d-eh/<language>/<toolchain>/<target>/<optimization>/<file>,
# so this depth leaves the generated-tree notice a diffable text file.
corpus/ada-d-eh/*/*/*/*/** binary

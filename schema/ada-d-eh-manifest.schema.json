{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeverSight/testbins/schema/ada-d-eh-manifest.schema.json",
  "title": "Ada and D Itanium exception corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus",
    "producer",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "corpus": {
      "const": "ada-d-eh"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "toolchainName": {
      "enum": [
        "gnat",
        "gdc",
        "dmd",
        "ldc"
      ]
    },
    "targetName": {
      "enum": [
        "x86_64-linux-gnu",
        "aarch64-linux-gnu"
      ]
    },
    "cellName": {
      "type": "string",
      "pattern": "^(gnat|gdc|dmd|ldc)-(x86_64-linux-gnu|aarch64-linux-gnu)$"
    },
    "toolchainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "toolchain",
        "target",
        "compiler",
        "version_prefix",
        "apt_packages",
        "dlang_compiler",
        "version",
        "version_string"
      ],
      "properties": {
        "cell": {
          "$ref": "#/$defs/cellName"
        },
        "toolchain": {
          "$ref": "#/$defs/toolchainName"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "compiler": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "apt_packages": {
          "$ref": "#/$defs/stringArray"
        },
        "dlang_compiler": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,2}$"
        },
        "version_string": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision",
        "toolchains"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/toolchainRecord"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LC_ALL",
        "SOURCE_DATE_EPOCH",
        "TZ"
      ],
      "properties": {
        "LC_ALL": {
          "const": "C"
        },
        "SOURCE_DATE_EPOCH": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "TZ": {
          "const": "UTC"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "compiler_flags",
        "source",
        "working_directory",
        "checkout_prefix",
        "environment",
        "path_strategy",
        "runner_image",
        "runner_os",
        "runner_arch"
      ],
      "properties": {
        "compiler": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "compiler_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^sources/ada-d-eh/(ada_eh_probe\\.adb|d_eh_probe\\.d)$"
        },
        "working_directory": {
          "const": "/testbins"
        },
        "checkout_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "path_strategy": {
          "enum": [
            "compiler-prefix-map",
            "relative-source-no-debug"
          ]
        },
        "runner_image": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runner_os": {
          "const": "linux"
        },
        "runner_arch": {
          "const": "x64"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_sections",
        "required_symbols",
        "required_strings",
        "require_unwind_tables",
        "eh_frame_present",
        "checkout_path_absent"
      ],
      "properties": {
        "required_sections": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "required_symbols": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "required_strings": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "require_unwind_tables": {
          "const": true
        },
        "eh_frame_present": {
          "const": true
        },
        "checkout_path_absent": {
          "const": true
        }
      }
    },
    "neverd": {
      "description": "Three independent capability claims: LSDA parsing, address-preserving native reconstruction, and proof by a real corpus artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_level",
        "personalities_any",
        "type_table_interpretation",
        "descriptor_abi",
        "native_reconstruction",
        "corpus_proven",
        "min_call_sites",
        "min_landing_pads",
        "min_catch_clauses",
        "min_cleanup_pads",
        "min_type_table_entries"
      ],
      "properties": {
        "validation_level": {
          "const": "lsda-graph"
        },
        "personalities_any": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "type_table_interpretation": {
          "const": "opaque-descriptor"
        },
        "descriptor_abi": {
          "enum": [
            "gnat-exception-id",
            "d-classinfo"
          ]
        },
        "native_reconstruction": {
          "const": "address-clauses"
        },
        "corpus_proven": {
          "const": true
        },
        "min_call_sites": {
          "type": "integer",
          "minimum": 1
        },
        "min_landing_pads": {
          "type": "integer",
          "minimum": 1
        },
        "min_catch_clauses": {
          "type": "integer",
          "minimum": 1
        },
        "min_cleanup_pads": {
          "type": "integer",
          "minimum": 0
        },
        "min_type_table_entries": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size",
        "toolchain",
        "toolchain_version",
        "target",
        "architecture",
        "object_format",
        "source_language",
        "optimization",
        "execution",
        "exception_model",
        "build",
        "evidence",
        "neverd"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^corpus/ada-d-eh/(ada|d)/(gnat|gdc|dmd|ldc)/(x86_64-linux-gnu|aarch64-linux-gnu)/(o0|o2)/[a-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "toolchain": {
          "$ref": "#/$defs/toolchainName"
        },
        "toolchain_version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,2}$"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "object_format": {
          "const": "elf"
        },
        "source_language": {
          "enum": [
            "ada",
            "d"
          ]
        },
        "optimization": {
          "enum": [
            "o0",
            "o2"
          ]
        },
        "execution": {
          "enum": [
            "passed",
            "not-run-cross-target"
          ]
        },
        "exception_model": {
          "const": "itanium-dwarf"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "neverd": {
          "$ref": "#/$defs/neverd"
        }
      }
    }
  }
}
